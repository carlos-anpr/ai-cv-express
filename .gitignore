# Env - las claves reales SOLO viven en .env local, nunca versionado
# (.env.example es la plantilla sin secretos y SI se versiona)
.env
.env*.local
*.local

# CVs generados (datos personales: nombre, email, telefono)
CV/

# backups locales (pueden contener datos personales)
backups/

# Bundles de backup de git (pueden contener historia antigua)
*.bundle

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

